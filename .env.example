# Source artifacts and session output live outside the Git checkout.
RAX_ARTIFACT_ROOT=/path/to/autorax-artifacts

# Piper sessions read backend options from this JSON file.
RAX_BACKEND_OPTIONS=/absolute/path/to/piper.json

# Colon-separated controller, SDK, and configuration paths hidden from the agent.
RAX_PROTECTED_PATHS=/path/to/piper-sdk:/path/to/site-config
